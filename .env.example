VITE_API_BASE_URL=/api/v1
# 本地开发时如后端未开放 CORS，可临时设置为后端源地址，例如 http://backend-host:8081。
# Vite 只在开发服务器中将 /api/v1 转发到该地址，不要提交真实内网地址。
VITE_API_PROXY_TARGET=
# 如前端部署在 https://example.com/idmp/，构建时设为 /idmp/；部署站点根目录时保留 /。
VITE_PUBLIC_BASE=/
VITE_DEFAULT_DRILL_PATH_CODE=ORGANIZATION
VITE_DEFAULT_DRILL_MAX_LEVEL=OUT_DEPT
